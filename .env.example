# Application
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL="postgresql://cinepath_user:cinepath_password@localhost:5432/cinepath_db?schema=public"

# Redis (Atomic seat locks & caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Authentication (JWT)
JWT_SECRET=super_secret_jwt_access_key_change_me_in_production_min32chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=super_secret_refresh_key_change_me_in_production_min32chars
REFRESH_TOKEN_EXPIRES_IN=7d

# QR Code Ticket Signature (HMAC)
QR_SECRET=hmac_qr_signature_secret_key_change_me_min32chars

# Stripe Payments (test mode)
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder

# TMDB Movie Database API (Optional: free key from https://www.themoviedb.org/settings/api)
TMDB_API_KEY=your_tmdb_api_key_here

# Email (SMTP / Mailtrap / Resend)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
EMAIL_FROM="CinePath <noreply@cinepath.com>"

